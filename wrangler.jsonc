{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "em-iacvut",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-16",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
